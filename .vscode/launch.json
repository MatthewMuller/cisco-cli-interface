{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Cisco CLI (Local)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/cisco-cli-interface",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "TERM",
                    "value": "xterm-256color"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "docker-build-debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            }
        },
        {
            "name": "Debug Cisco CLI (Docker)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/app/build/cisco-cli-interface",
            "args": [],
            "stopAtEntry": false,
            "cwd": "/app",
            "environment": [
                {
                    "name": "TERM",
                    "value": "xterm-256color"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "docker-build-debug",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false
            }
        },
        {
            "name": "Attach to Cisco CLI Process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/cisco-cli-interface",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
